# Токен от @BotFather. Других обязательных настроек нет.
TELEGRAM_BOT_TOKEN=
# По умолчанию exports/blue-pack.zip; можно указать абсолютный путь.
PACK_ARCHIVE=exports/blue-pack.zip
# Необязательно: ваш числовой Telegram ID. Если пусто, код привязки будет в консоли.
TELEGRAM_OWNER_ID=
# V2: минимальная пауза между загрузкой/созданием/добавлением, в секундах.
# При 429 бот сам увеличит её и сохранит ожидание между перезапусками.
PACK_REQUEST_INTERVAL=8
# Пароль страницы редактора, когда она открыта через Cloudflare-туннель (server/remote.ts).
SITE_PASSWORD=
# Ключ, которым редактор управляет ботом V2 (кнопка «В Telegram»); порт только на 127.0.0.1.
BOT_CONTROL_TOKEN=
BOT_CONTROL_PORT=8790
